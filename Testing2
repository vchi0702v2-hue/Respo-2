(r[ci.reason]||'').trim(),bench:Number(r[ci.bench])||0,reqNum:String(r[ci.reqNum]||'').trim(),benchFinal:Number(r[ci.benchFinal])||0,filledPreId:String(r[ci.filledPreId]||'').trim().toLowerCase(),notFilledReason:String(r[ci.notFilledReason]||'').trim(),ttoa:tt,sourceOfFill:String(r[ci.sourceOfFill]||'').trim(),region:countryToRegion(co),dateReq:dr,cdds:cd});}return nd;}
