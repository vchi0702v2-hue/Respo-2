<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>Proactive Sourcing — Executive Report FY26</title>
<script src="https://cdnjs.cloudflare.com/ajax/libs/Chart.js/4.4.1/chart.umd.min.js"></script>
<script src="https://cdnjs.cloudflare.com/ajax/libs/xlsx/0.18.5/xlsx.full.min.js"></script>
<style>
@import url('https://fonts.googleapis.com/css2?family=Playfair+Display:wght@400;500;600;700;800;900&family=DM+Sans:wght@300;400;500;600;700&display=swap');

*{margin:0;padding:0;box-sizing:border-box}

:root{
  --red:#E60012;--red-soft:rgba(230,0,18,.06);
  --red-dark:#A30020;--gray-lt:#CCCCCC;--gray-md:#808080;--charcoal:#363636;--pink:#F0ADAD;
  --ink:#1a1a2e;--ink2:#2d2d44;--ink3:#4a4a64;
  --muted:#8b8ba0;--light:#c4c4d4;--gray:#bbb;
  --bg:#f7f7fa;--card:#ffffff;--border:#eaeaf0;--border2:#f0f0f5;
  --radius:16px;--radius-sm:10px;
}

body{
  font-family:'DM Sans',-apple-system,BlinkMacSystemFont,sans-serif;
  background:var(--bg);color:var(--ink);
  min-height:100vh;
  -webkit-font-smoothing:antialiased;
}

/* ===================== HEADER ===================== */
.masthead{
  background:#fff;
  border-bottom:1px solid var(--border);
  padding:0 48px;
  position:sticky;top:0;z-index:100;
  box-shadow:0 1px 0 rgba(0,0,0,.03);
}
.masthead-inner{
  display:flex;align-items:center;justify-content:space-between;
  max-width:1440px;margin:0 auto;
  height:64px;
}
.masthead-left{display:flex;align-items:center;gap:16px}
.logo{width:30px;height:28px;flex-shrink:0}
.masthead-title{
  font-family:'Playfair Display',serif;
  font-size:18px;font-weight:700;letter-spacing:-.4px;
  color:var(--ink);
}
.masthead-sub{font-size:11px;color:var(--muted);font-weight:400;margin-top:0}
.masthead-right{display:flex;align-items:center;gap:12px}
.meta-pill{
  background:var(--bg);border:1px solid var(--border);
  border-radius:20px;padding:5px 14px;
  font-size:11px;color:var(--muted);font-weight:500;
  cursor:pointer;transition:all .25s;user-select:none;
  position:relative;
}
.meta-pill strong{color:var(--ink);font-weight:600}
.meta-pill .okr-dot{
  display:inline-block;width:8px;height:8px;border-radius:50%;
  margin-right:6px;vertical-align:middle;transition:background .3s;
}
.okr-green .okr-dot{background:#22c55e}
.okr-green{border-color:#22c55e;background:rgba(34,197,94,.06)}
.okr-amber .okr-dot{background:#f59e0b}
.okr-amber{border-color:#f59e0b;background:rgba(245,158,11,.06)}
.okr-red .okr-dot{background:var(--red)}
.okr-red{border-color:var(--red);background:var(--red-soft)}

.okr-menu{
  position:absolute;top:calc(100% + 8px);left:0;
  background:#fff;border:1px solid var(--border);border-radius:12px;
  box-shadow:0 8px 24px rgba(0,0,0,.12);
  padding:6px;min-width:160px;z-index:300;
  opacity:0;visibility:hidden;transform:translateY(-4px);
  transition:all .2s;
}
.okr-menu.open{opacity:1;visibility:visible;transform:translateY(0)}
.okr-opt{
  display:flex;align-items:center;gap:8px;
  padding:8px 12px;border-radius:8px;cursor:pointer;
  font-size:11px;font-weight:500;color:var(--ink3);
  transition:background .15s;
}
.okr-opt:hover{background:var(--bg)}
.okr-opt .okr-dot{margin-right:0}
.okr-opt.selected{font-weight:700;color:var(--ink)}
.upload-trigger{
  display:flex;align-items:center;gap:6px;
  padding:6px 14px;border-radius:20px;
  border:1.5px dashed var(--border);
  font-size:11px;color:var(--muted);font-weight:500;
  cursor:pointer;transition:all .25s;background:#fff;
}
.upload-trigger:hover{border-color:var(--red);color:var(--red);background:var(--red-soft)}
.upload-trigger.loaded{border-color:var(--charcoal);color:var(--charcoal);border-style:solid}
.upload-trigger input{display:none}
.upload-trigger svg{width:14px;height:14px}
.last-saved{
  font-size:10px;color:var(--muted);font-weight:400;
  display:flex;align-items:center;gap:4px;
}
.last-saved .dot{width:6px;height:6px;border-radius:50%;background:var(--charcoal);display:inline-block}

/* ===================== FILTER STRIP ===================== */
.filter-strip{
  background:#fff;border-bottom:1px solid var(--border);
  padding:0 48px;overflow:hidden;
  max-height:0;transition:max-height .35s cubic-bezier(.4,0,.2,1);
}
.filter-strip.open{max-height:200px}
.filter-strip-inner{
  max-width:1440px;margin:0 auto;
  display:flex;gap:8px;flex-wrap:wrap;align-items:center;
  padding:12px 0;
}
.filter-toggle{
  display:flex;align-items:center;gap:5px;
  padding:6px 14px;border-radius:20px;
  border:1px solid var(--border);background:#fff;
  font-size:11px;color:var(--ink3);font-weight:600;font-family:inherit;
  cursor:pointer;transition:all .2s;
}
.filter-toggle:hover{border-color:var(--ink3)}
.filter-toggle.has-filters{border-color:var(--red);color:var(--red);background:var(--red-soft)}
.filter-toggle svg{width:12px;height:12px}
.fdiv{width:1px;height:20px;background:var(--border);margin:0 4px}
.flbl{
  font-size:8px;font-weight:700;text-transform:uppercase;
  letter-spacing:1.5px;color:var(--light);margin-right:2px;
}
.fb{
  background:#fff;border:1px solid var(--border);
  border-radius:20px;padding:5px 12px;
  font-size:10px;font-weight:500;color:var(--ink3);
  cursor:pointer;transition:all .2s;font-family:inherit;white-space:nowrap;
}
.fb:hover{border-color:var(--ink3);color:var(--ink)}
.fb.act{color:#fff}
.fb.act::before{content:'\2713\00a0';font-size:8px;font-weight:700}
.fb-src.act{background:var(--red);border-color:var(--red)}
.fb-st.act{background:var(--red-dark);border-color:var(--red-dark)}
.fb-tp.act{background:var(--gray-md);border-color:var(--gray-md)}
.fb-co.act{background:var(--charcoal);border-color:var(--charcoal)}
.fb-rs.act{background:var(--red-dark);border-color:var(--red-dark)}
.fb-mo.act{background:var(--gray-md);border-color:var(--gray-md)}

/* Active Chips Bar */
.chips-bar{
  background:#fff;border-bottom:1px solid var(--border);
  padding:0 48px;display:none;
}
.chips-bar.vis{display:block}
.chips-inner{
  max-width:1440px;margin:0 auto;
  display:flex;align-items:center;gap:8px;flex-wrap:wrap;
  padding:10px 0;
}
.chip{
  display:inline-flex;align-items:center;gap:5px;
  background:var(--red-soft);border:1px solid rgba(230,0,18,.2);
  border-radius:16px;padding:3px 8px 3px 10px;
  font-size:10px;font-weight:500;color:var(--ink);
  animation:chipIn .2s ease;
}
.chip-dim{font-size:8px;text-transform:uppercase;letter-spacing:.8px;color:var(--muted);font-weight:600}
@keyframes chipIn{from{opacity:0;transform:scale(.9)}to{opacity:1;transform:scale(1)}}
.chip-x{
  width:14px;height:14px;border-radius:50%;border:none;
  background:rgba(230,0,18,.12);color:var(--red);
  cursor:pointer;display:flex;align-items:center;justify-content:center;
  font-size:10px;line-height:1;font-family:inherit;transition:all .15s;
}
.chip-x:hover{background:var(--red);color:#fff}
.chips-count{font-size:10px;color:var(--muted);font-weight:500}
.chips-clear{
  margin-left:auto;border:1px solid var(--border);border-radius:16px;
  padding:3px 12px;font-size:10px;font-weight:600;
  color:var(--muted);background:#fff;cursor:pointer;font-family:inherit;
  transition:all .15s;
}
.chips-clear:hover{border-color:var(--red);color:var(--red)}

/* ===================== CONTAINER ===================== */
.container{max-width:1440px;margin:0 auto;padding:28px 48px 60px}

/* ===================== KPI SECTION ===================== */
.kpi-section{display:flex;gap:20px;margin-bottom:28px;align-items:stretch;overflow:visible}
.kpi-group{flex:1 1 0;min-width:0;display:flex;flex-direction:column;overflow:visible}
.kpi-group-wide{flex:2 1 0;min-width:0;display:flex;flex-direction:column;overflow:visible}

.kpi-topic{
  font-family:'DM Sans',sans-serif;
  font-size:10px;font-weight:700;text-transform:uppercase;letter-spacing:2.5px;
  padding:8px 0;text-align:center;
  border-radius:var(--radius-sm) var(--radius-sm) 0 0;
  position:relative;z-index:2;
  overflow:visible;
}
.kpi-topic-blue{background:var(--red);color:#fff}
.kpi-topic-purple{background:var(--red-dark);color:#fff}
.kpi-topic-green{background:var(--charcoal);color:#fff}
.kpi-topic-amber{background:var(--gray-md);color:#fff}

/* Info tooltip */
.info-wrap{position:absolute;right:12px;top:50%;transform:translateY(-50%);display:inline-flex}
.info-i{
  width:16px;height:16px;border-radius:50%;
  display:inline-flex;align-items:center;justify-content:center;
  font-size:10px;font-weight:600;font-style:normal;
  font-family:'DM Sans',sans-serif;
  color:rgba(255,255,255,.6);border:1.5px solid rgba(255,255,255,.35);
  cursor:help;transition:all .2s;
  line-height:1;padding:0 0 0 2.5px;text-indent:0;
}
.info-i:hover{color:#fff;border-color:#fff;background:rgba(255,255,255,.15)}
.info-tip{
  position:absolute;top:calc(100% + 10px);right:0;transform:none;
  width:280px;padding:14px 16px;
  background:#fff;color:var(--ink);
  border:1px solid var(--border);border-radius:12px;
  box-shadow:0 8px 30px rgba(0,0,0,.12);
  font-family:'DM Sans',sans-serif;font-size:12px;font-weight:400;
  line-height:1.55;letter-spacing:0;text-transform:none;
  opacity:0;visibility:hidden;
  transition:opacity .2s,visibility .2s,transform .2s;
  transform:translateY(-4px);
  z-index:200;pointer-events:none;
}
.info-tip::before{
  content:'';position:absolute;top:-6px;right:14px;
  width:12px;height:12px;background:#fff;
  border-left:1px solid var(--border);border-top:1px solid var(--border);
  transform:rotate(45deg);
}
.info-wrap:hover .info-tip{opacity:1;visibility:visible;transform:translateY(0)}

.kpi-body{
  background:var(--card);
  border:1px solid var(--border);border-top:none;
  border-radius:0 0 var(--radius) var(--radius);
  flex:1;display:flex;flex-direction:column;
  box-shadow:0 2px 12px rgba(0,0,0,.04);
  min-height:130px;
}
.kpi-body-grid{
  display:grid;grid-template-columns:1fr 1fr;
}
.kpi-body-grid .kpi-tile{border-right:1px solid var(--border2)}
.kpi-body-grid .kpi-tile:last-child{border-right:none}

.kpi-tile{
  padding:20px 24px 24px;text-align:center;cursor:pointer;
  transition:background .2s;flex:1;
  display:flex;flex-direction:column;align-items:center;
  justify-content:flex-start;
}
.kpi-tile:hover{background:var(--bg)}

.kpi-number{
  font-family:'Playfair Display',serif;
  font-size:44px;font-weight:800;letter-spacing:-2px;
  line-height:1;margin-bottom:20px;
  transition:transform .3s cubic-bezier(.34,1.56,.64,1);
}
.kpi-tile:hover .kpi-number{transform:scale(1.05)}
.kpi-label{
  font-size:9px;font-weight:600;text-transform:uppercase;
  letter-spacing:1px;color:var(--muted);line-height:1.5;
  margin-top:-4px;white-space:pre-line;
}
.kpi-covered{
  font-size:9px;font-weight:500;color:var(--light);
  margin-top:8px;letter-spacing:0;text-transform:none;
}
.kpi-sub{font-size:10px;color:var(--light);margin-top:3px;font-weight:400}
.num-blue{color:var(--red)}.num-purple{color:var(--red-dark)}
.num-teal{color:var(--charcoal)}.num-green{color:var(--charcoal)}.num-amber{color:var(--gray-md)}

/* ===================== GRID ===================== */
.grid{display:grid;grid-template-columns:1fr 1fr;gap:20px}
.grid-full{grid-column:1/-1}

.card{
  background:var(--card);border:1px solid var(--border);
  border-radius:var(--radius);overflow:hidden;
  box-shadow:0 1px 4px rgba(0,0,0,.03);
  transition:box-shadow .25s,border-color .25s;
}
.card:hover{box-shadow:0 4px 16px rgba(0,0,0,.06);border-color:#ddd}

.card-head{
  padding:20px 24px 14px;
  display:flex;align-items:baseline;justify-content:space-between;
}
.card-title{
  font-family:'Playfair Display',serif;
  font-size:15px;font-weight:600;letter-spacing:-.2px;color:var(--ink);
}
.card-tag{
  font-size:8px;font-weight:700;text-transform:uppercase;
  letter-spacing:1.2px;color:var(--light);
  padding:3px 8px;border-radius:6px;background:var(--bg);
}
.card-body{padding:0 24px 24px}

.chart-area{position:relative;width:100%;height:260px}
.chart-area-sm{position:relative;width:100%;height:220px}
.chart-area-trend{position:relative;width:100%;height:180px}

/* ===================== TABLE ===================== */
.tbl{width:100%;border-collapse:separate;border-spacing:0}
.tbl th{
  text-align:left;font-size:9px;font-weight:700;
  text-transform:uppercase;letter-spacing:1.2px;
  color:var(--light);padding:10px 12px;
  border-bottom:2px solid var(--border);
  cursor:pointer;user-select:none;white-space:nowrap;
  transition:color .15s;position:sticky;top:0;background:#fff;z-index:1;
}
.tbl th:hover{color:var(--ink)}
.tbl th .sa{display:inline-block;margin-left:3px;font-size:8px;opacity:.35;transition:opacity .15s}
.tbl th.sasc .sa,.tbl th.sdsc .sa{opacity:1;color:var(--red)}
.tbl th.sasc .sa::after{content:'\25B2'}.tbl th.sdsc .sa::after{content:'\25BC'}
.tbl th:not(.sasc):not(.sdsc) .sa::after{content:'\25B4\25BE';font-size:6px;letter-spacing:-2px}
.tbl td{
  padding:10px 12px;font-size:11px;color:var(--ink3);
  border-bottom:1px solid var(--border2);
  transition:background .12s;
}
.tbl tbody tr{cursor:default}
.tbl tbody tr:hover td{background:rgba(230,0,18,.02)}
.tbl .t-title{color:var(--ink);font-weight:500}
.sb{
  display:inline-block;padding:3px 10px;border-radius:20px;
  font-size:9px;font-weight:600;white-space:nowrap;
}
.sb-f{background:rgba(230,0,18,.08);color:var(--red)}
.sb-nl{background:rgba(163,0,32,.06);color:var(--red-dark)}
.sb-l{background:rgba(128,128,128,.1);color:var(--gray-md)}
.sb-c{background:rgba(0,0,0,.04);color:var(--gray-lt)}

/* ===================== HORIZONTAL BARS ===================== */
.hbar{margin-bottom:14px}
.hbar-label{font-size:11px;color:var(--ink3);margin-bottom:4px;display:flex;justify-content:space-between;font-weight:500}
.hbar-track{height:28px;background:var(--bg);border-radius:8px;overflow:hidden}
.hbar-fill{
  height:100%;border-radius:8px;
  transition:width .7s cubic-bezier(.22,1,.36,1);
  display:flex;align-items:center;padding-left:10px;
  font-size:10px;font-weight:700;color:#fff;min-width:28px;
}
.empty{text-align:center;padding:40px 20px;color:var(--light);font-size:12px}

/* ===================== ANIMATIONS ===================== */
.fade-in{animation:fadeIn .5s ease both}
@keyframes fadeIn{from{opacity:0;transform:translateY(8px)}to{opacity:1;transform:translateY(0)}}
.d1{animation-delay:.05s}.d2{animation-delay:.1s}.d3{animation-delay:.15s}
.d4{animation-delay:.2s}.d5{animation-delay:.25s}.d6{animation-delay:.3s}
.d7{animation-delay:.35s}.d8{animation-delay:.4s}

/* ===================== FOOTER ===================== */
.foot{
  text-align:center;padding:20px 48px;
  font-size:10px;color:var(--light);letter-spacing:.5px;
}

/* ===================== RESPONSIVE ===================== */
@media(max-width:1024px){
  .masthead,.filter-strip,.chips-bar{padding:0 20px}
  .container{padding:20px}
  .kpi-section{flex-direction:column;gap:14px}
  .kpi-group-wide{flex:1}
  .grid{grid-template-columns:1fr}
}

::-webkit-scrollbar{width:6px}
::-webkit-scrollbar-thumb{background:#ddd;border-radius:3px}
</style>
</head>
<body>

<!-- MASTHEAD -->
<header class="masthead">
<div class="masthead-inner">
  <div class="masthead-left">
    <svg class="logo" viewBox="0 0 36 34" fill="none"><path d="M13.9 0H0V33.5L13.9 0Z" fill="#E60012"/><path d="M22.1 0H36V33.5L22.1 0Z" fill="#E60012"/><path d="M18 11.8L26.1 33.5H21.2L18.8 27H12.4L18 11.8Z" fill="#E60012"/></svg>
    <div>
      <div class="masthead-title">Proactive Sourcing</div>
