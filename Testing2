  <div class="fdiv"></div>
  <span class="flbl" id="lbl-country">Region</span>
  <button class="fb fb-co" data-dim="country" data-val="AU">Australia</button>
  <button class="fb fb-co" data-dim="country" data-val="SG">Singapore</button>
  <button class="fb fb-co" data-dim="country" data-val="KR">Korea</button>
  <button class="fb fb-co" data-dim="country" data-val="OT">Other</button>
  <div class="fdiv"></div>
  <span class="flbl" id="lbl-reason">Reason</span>
  <button class="fb fb-rs" data-dim="reason" data-val="New HC">New HC</button>
  <button class="fb fb-rs" data-dim="reason" data-val="Internal Movement">Internal Move</button>
  <button class="fb fb-rs" data-dim="reason" data-val="Performance">Performance</button>
