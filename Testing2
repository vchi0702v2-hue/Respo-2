  if(sortCol){sorted.sort((a,b)=>{let va=a[sortCol],vb=b[sortCol];if(sortCol==='ttoa'||sortCol==='bench'){va=va!==null?va:99999;vb=vb!==null?vb:99999;return sortDir==='asc'?va-vb:vb-va;}va=(va||'').toString().toLowerCase();vb=(vb||'').toString().toLowerCase();return va<vb?(sortDir==='asc'?-1:1):va>vb?(sortDir==='asc'?1:-1):0;});}
  const fmtDate=d=>{if(!d)return'—';const[y,m]=d.split('-');const mn=['','Jan','Feb','Mar','Apr','May','Jun','Jul','Aug','Sep','Oct','Nov','Dec'];return(mn[parseInt(m)]||m)+' '+y;};
  let tb='';sorted.forEach(r=>{tb+=`<tr><td><span class="sb ${stB(r.status)}">${r.status}</span></td><td class="t-title">${r.jobTitle}</td><td style="white-space:nowrap">${fmtDate(r.dateReq)}</td><td>${r.level}</td><td>${r.roleType||'—'}</td><td>${r.country}</td><td>${r.bu||'—'}</td><td>${r.tp}</td><td>${r.reason||'—'}</td><td style="font-weight:600;color:${r.ttoa?'var(--ink)':'var(--light)'}">${r.ttoa!==null?r.ttoa+'d':'—'}</td><td style="font-weight:600;color:${r.bench?'var(--ink)':'var(--light)'}">${r.bench||'—'}</td><td>${r.filledPreId==='yes'?'<span style="color:var(--ink)">Yes</span>':r.filledPreId==='no'?'<span style="color:var(--red)">No</span>':'—'}</td><td>${r.sourceOfFill||'—'}</td></tr>`;});
  document.querySelector('#tbl tbody').innerHTML=tb;
  document.querySelectorAll('#tbl th[data-col]').forEach(th=>{th.classList.remove('sasc','sdsc');if(th.dataset.col===sortCol)th.classList.add(sortDir==='asc'?'sasc':'sdsc');});
}

document.querySelectorAll('#tbl th[data-col]').forEach(th=>{th.addEventListener('click',()=>{const c=th.dataset.col;if(sortCol===c)sortDir=sortDir==='asc'?'desc':'asc';else{sortCol=c;sortDir='asc';}updateAll();});});

initCharts();

// ===== OKR STATUS =====
const okrPill=document.getElementById('okrPill');
const okrMenu=document.getElementById('okrMenu');
okrPill.addEventListener('click',e=>{e.stopPropagation();okrMenu.classList.toggle('open');});
document.addEventListener('click',()=>okrMenu.classList.remove('open'));
okrMenu.addEventListener('click',e=>e.stopPropagation());

document.querySelectorAll('.okr-opt').forEach(opt=>{
  opt.addEventListener('click',async()=>{
    const c=opt.dataset.color;
    okrPill.classList.remove('okr-green','okr-amber','okr-red');
    okrPill.classList.add('okr-'+c);
    document.querySelectorAll('.okr-opt').forEach(o=>o.classList.remove('selected'));
    opt.classList.add('selected');
    okrMenu.classList.remove('open');
    try{if(window.storage)await window.storage.set('ps-okr-status',c,true);}catch(e){}
  });
});

// Load saved OKR status
(async()=>{
  try{
    if(window.storage){
      let r=null;
      try{r=await window.storage.get('ps-okr-status',true);}catch(e){}
      if(r&&r.value){
        const c=r.value;
        okrPill.classList.remove('okr-green','okr-amber','okr-red');
        okrPill.classList.add('okr-'+c);
        document.querySelectorAll('.okr-opt').forEach(o=>{
          o.classList.toggle('selected',o.dataset.color===c);
        });
      }
    }
  }catch(e){}
})();

// Load saved data if available, otherwise use hardcoded default
(async()=>{
  const loaded=await loadSavedData();
  if(!loaded){
    document.getElementById('uploadLabel').textContent='Default data · Upload to update';
  }
  syncUI();updateAll();
})();
</script>
</body>
</html>
