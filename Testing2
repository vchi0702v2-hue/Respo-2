  <div class="fdiv"></div>
  <span class="flbl" id="lbl-month">Month</span>
  <button class="fb fb-mo" data-dim="month" data-val="2025-05">May 25</button>
  <button class="fb fb-mo" data-dim="month" data-val="2025-07">Jul 25</button>
  <button class="fb fb-mo" data-dim="month" data-val="2025-08">Aug 25</button>
  <button class="fb fb-mo" data-dim="month" data-val="2025-11">Nov 25</button>
  <button class="fb fb-mo" data-dim="month" data-val="2025-12">Dec 25</button>
  <button class="fb fb-mo" data-dim="month" data-val="2026-01">Jan 26</button>
  <button class="fb fb-mo" data-dim="month" data-val="2026-02">Feb 26</button>
