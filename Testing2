async function saveData(fileName){
  try{
    if(window.storage){
      const meta={fileName:fileName||'manual',date:new Date().toISOString(),rows:DATA.length};
      await window.storage.set('ps-dashboard-data',JSON.stringify(DATA),true);
      await window.storage.set('ps-dashboard-meta',JSON.stringify(meta),true);
      let history=[];
      try{const h=await window.storage.get('ps-dashboard-history',true);if(h)history=JSON.parse(h.value);}catch(e){}
      history.push(meta);
      if(history.length>50)history=history.slice(-50);
      await window.storage.set('ps-dashboard-history',JSON.stringify(history),true);
      showSavedIndicator(meta);
    }
  }catch(e){}
}

async function loadSavedData(){
  try{
    if(window.storage){
      let result=null,metaResult=null;
      try{result=await window.storage.get('ps-dashboard-data',true);}catch(e){}
      try{metaResult=await window.storage.get('ps-dashboard-meta',true);}catch(e){}
      if(result&&result.value){
        const saved=JSON.parse(result.value);
        if(saved&&saved.length){
          DATA=saved;
          rebuildDims();
          if(metaResult&&metaResult.value){
            const meta=JSON.parse(metaResult.value);
            showSavedIndicator(meta);
            document.getElementById('uploadLabel').textContent=meta.fileName+' · Saved as default';
            document.getElementById('dropZone').classList.add('loaded');
          }
          return true;
        }
      }
    }
  }catch(e){}
  return false;
}

function showSavedIndicator(meta){
  const el=document.getElementById('lastSaved');
  const txt=document.getElementById('lastSavedText');
  if(el&&txt&&meta){
    const d=new Date(meta.date);
    const fmt=d.toLocaleDateString('en-AU',{day:'numeric',month:'short',year:'numeric',hour:'2-digit',minute:'2-digit'});
    txt.textContent=`Saved ${fmt} · ${meta.rows} rows`;
    el.style.display='flex';
  }
}
