        <div class="okr-opt" data-color="red"><span class="okr-dot" style="background:#E60012"></span>Needs Focus</div>
      </div>
    </div>
    <span class="last-saved" id="lastSaved" style="display:none"><span class="dot"></span><span id="lastSavedText"></span></span>
    <button class="filter-toggle" id="filterToggle" title="Toggle filters">
